#!/usr/bin/env bash

case "$(printf "kill\nsuspend\nlogout\nreboot\nshutdown" | rofi -i -dmenu -p "sys" )" in
	kill) ps -u $USER -o pid,comm,%cpu,%mem | rofi -dmenu -case-smart -p "kill" | awk '{print $1}' | xargs -r kill ;;
	suspend) systemctl suspend ;;
	reboot) systemctl reboot -i ;;
	shutdown) shutdown now ;;
	*) exit 1 ;;
esac
